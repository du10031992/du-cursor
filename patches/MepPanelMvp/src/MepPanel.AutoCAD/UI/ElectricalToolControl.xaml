<UserControl x:Class="MepPanelMvp.UI.ElectricalToolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl"
             Background="{DynamicResource PluginBackgroundBrush}"
             Foreground="{DynamicResource PluginTextBrush}">
  <UserControl.Resources>
    <SolidColorBrush x:Key="PluginBackgroundBrush" Color="#1F2023"/>
    <SolidColorBrush x:Key="PluginPanelBrush" Color="#292B2F"/>
    <SolidColorBrush x:Key="PluginButtonBrush" Color="#34363A"/>
    <SolidColorBrush x:Key="PluginTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PluginMutedTextBrush" Color="#B9BDC2"/>
    <SolidColorBrush x:Key="PluginAccentBrush" Color="#FF9B50"/>
    <SolidColorBrush x:Key="PluginBorderBrush" Color="#595C61"/>
    <SolidColorBrush x:Key="PluginSuccessBrush" Color="#74D68A"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PluginTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PluginButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PluginBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10">
      <TextBlock Text="MEP DRAWING TOOL"
                 FontSize="16" FontWeight="Bold"
                 HorizontalAlignment="Center"
                 Margin="0,4,0,2"/>
      <TextBlock Text="ELECTRICAL + HVAC SYSTEM  v0.13.0"
                 FontSize="11"
                 Foreground="{DynamicResource PluginMutedTextBrush}"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,8"/>

      <Button x:Name="ThemeButton"
              Content="Giao diện"
              Click="ThemeButton_Click"
              Margin="0,0,0,10"
              Padding="8,6"
              ToolTip="Chọn giao diện Carbon CAD, Navy Engineering, Light Technical hoặc Steel Control"/>

      <TextBlock Text="HỆ THỐNG" FontWeight="Bold" Margin="0,0,0,6"
                 Foreground="{DynamicResource PluginAccentBrush}"/>
      <UniformGrid Columns="2">
        <Button Content="HỆ ĐIỆN"
                Background="#A83B35"
                Tag="MEPDBDRAW"
                Click="OpenElectricalConfiguration_Click"
                Margin="0,0,4,6"/>
        <Button Content="HỆ NƯỚC"
                Background="#28758A"
                Tag="MEPDBWATER"
                Click="HeNuoc_Click"
                Margin="4,0,0,6"/>
        <Button Content="BÁO CHÁY"
                Background="#8B4B2B"
                Tag="MEPDBSMOKE"
                Click="BaoChay_Click"
                Margin="0,0,4,6"/>
        <Button Content="ĐIỀU HÒA"
                Background="#315D7C"
                Tag="MEPHVAC"
                Click="Hvac_Click"
                Margin="4,0,0,6"/>
      </UniformGrid>

      <TextBlock Text="CHỨC NĂNG CHUNG" FontWeight="Bold" Margin="0,8,0,6"
                 Foreground="{DynamicResource PluginAccentBrush}"/>

      <Button Content="Chọn layer" Tag="MEPSELAYER" Click="SelectLayer_Click"/>
      <Button Content="Cấu hình tủ" Tag="MEPDBCONFIG" Click="OpenPanelConfiguration_Click" Background="#315D7C"/>
      <Button Content="Xuất CSV" Tag="MEPDBEXPORT" Click="Export_Click" Background="#4F477D"/>
      <Button Content="Tủ mới" Tag="MEPDBCONFIG" Click="NewPanel_Click" Background="#536B42"/>
      <Button Content="Sửa tủ" Tag="MEPDBUPDATE" Click="EditPanel_Click" Background="#7B572E"/>
      <Button Content="Xuất Excel" Tag="MEPDBEXCEL" Click="Excel_Click" Background="#8B4B2B"/>
      <Button Content="Bản chiếu tủ" Tag="MEPDBCABINETVIEWS" Click="CabinetViews_Click" Background="#6B3E78"/>
      <Button Content="Sơ đồ nguồn" Tag="MEPDBPOWER" Click="PowerLayout_Click"
              ToolTip="Sơ đồ nguồn R-S-T-N-E"/>
      <Button Content="3P-4D+E" Tag="MEPDB3P4W" Click="ThreePhaseFourWire_Click" Background="#3F6074"/>
      <Button Content="Nạp block TB" Tag="MEPDBDRAW" Click="DeviceBlocks_Click"
              ToolTip="Chọn block MCCB/MCB/RCBO/SPD và dây"/>
      <Button Content="Vẽ tủ 2D" Tag="MEPDBCABINET2D" Click="Cabinet2d_Click" Background="#765033"
              ToolTip="Vẽ DWG tủ 2D từ cấu hình"/>
      <Button Content="Render mẫu tủ" Tag="MEPDBCABINET2D" Click="CabinetRender_Click" Background="#2F7772"
              ToolTip="Render PNG mẫu theo loại tủ"/>
      <Button Content="Trải tủ" Tag="MEPDBCABINET2D" Click="CabinetUnfold_Click"/>
      <Button Content="Kiến thức điện" Tag="MEPDBDRAW" Click="ElectricalKnowledge_Click" Background="#69552A"/>

      <TextBlock Text="LOẠI TỦ / TIỆN ÍCH" FontWeight="Bold" Margin="0,8,0,6"
                 Foreground="{DynamicResource PluginAccentBrush}"/>
      <Button Content="Tủ nhánh" Tag="MEPDBCONFIG" Click="BranchPanel_Click"/>
      <Button Content="Tủ tổng" Tag="MEPDBCONFIG" Click="MainPanel_Click"/>
      <Button Content="Đánh số lại" Tag="MEPDBCONFIG" Click="Renumber_Click"/>
      <Button Content="Nhân bản tủ" Tag="MEPDBCABINET2D" Click="DuplicatePanel_Click"/>
      <Button Content="Trợ giúp" Click="Help_Click"/>
      <Button Content="Đi dây thực tế" Tag="MEPDBCABINET2D" Click="RealisticWiring_Click" Background="#8A3F56"/>
      <Button Content="Render PNG dây" Tag="MEPDBCABINET2D" Click="RealisticWiringRender_Click" Background="#2F7772"
              ToolTip="Render PNG theo loại dây thiết bị hiện tại"/>

      <TextBlock x:Name="EditStatusText"
                 Text="Sẵn sàng — AutoCAD 2021"
                 FontSize="11"
                 Foreground="{DynamicResource PluginMutedTextBrush}"
                 Margin="0,10,0,4"
                 TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
