# Copy to .env and fill before: docker compose --env-file .env up -d

# Bat buoc doi truoc khi chay production. Toi thieu 32 ky tu.
JWT_KEY=your-random-jwt-key-at-least-32-characters-long

# Admin API key: ai co key nay se kiem soat toan bo user/thiet bi/quyen.
ADMIN_API_KEY=doi-thanh-key-rieng-cua-ban

# SMS thuc te. Neu de trong, khong gui duoc OTP production.
SMS_WEBHOOK_URL=https://your-sms-provider.example/send
SMS_API_KEY=your-sms-provider-api-key

# docker-compose da dat LicenseSettings__TestMode=false.
# KHONG dat lai thanh true tren production: TestMode dung OTP co dinh 123456
# va tra ma nay trong API, nghia la bat ky ai cung dang nhap duoc.
