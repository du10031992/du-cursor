<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>MepPanel.AutoCAD</RootNamespace>
    <AssemblyName>MepPanel.AutoCAD</AssemblyName>
    <AutoCadDir Condition="'$(AutoCadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2021</AutoCadDir>
    <BuildAutoCadPlugin Condition="Exists('$(AutoCadDir)\AcCoreMgd.dll')">true</BuildAutoCadPlugin>
    <BuildAutoCadPlugin Condition="'$(BuildAutoCadPlugin)' == ''">false</BuildAutoCadPlugin>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <!-- Máy có AutoCAD 2021: build plugin thật (cần Visual Studio trên Windows). -->
  <PropertyGroup Condition="'$(BuildAutoCadPlugin)' == 'true'">
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildAutoCadPlugin)' == 'true'">
    <Compile Include="**\*.cs" Exclude="Licensing\_BuildStub.cs" />
    <Page Include="**\*.xaml" />
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCadDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCadDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCadDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <!-- CI / máy chưa cài AutoCAD: giữ source, chỉ compile stub. -->
  <ItemGroup Condition="'$(BuildAutoCadPlugin)' != 'true'">
    <Compile Include="Licensing\_BuildStub.cs" />
    <None Include="**\*.cs" Exclude="Licensing\_BuildStub.cs" />
    <None Include="**\*.xaml" />
  </ItemGroup>

  <Target Name="WarnIfAutoCadMissing" BeforeTargets="Build" Condition="'$(BuildAutoCadPlugin)' != 'true'">
    <Warning Text="AutoCAD 2021 SDK không tìm thấy tại '$(AutoCadDir)'. Source licensing nằm trong Licensing\; build plugin trên máy Windows có AutoCAD." />
  </Target>
</Project>
