<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <AssemblyName>MepPanel.Plugin</AssemblyName>
    <RootNamespace>MepPanel.Plugin</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AutoCadDir Condition="'$(AutoCadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2021</AutoCadDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCadDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCadDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Build licensing trước, copy cạnh DLL chính — AutoCAD chỉ NETLOAD file chính. -->
  <ItemGroup>
    <ProjectReference Include="..\MepPanel.AutoCAD.Licensing\MepPanel.AutoCAD.Licensing.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyLicensingDll" AfterTargets="Build">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\MepPanel.AutoCAD.Licensing\bin\$(Configuration)\MepPanel.AutoCAD.Licensing.dll"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
